[Unit]
Description=HyadexServer
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/hyadex-server/current
Environment=HYADEX_STATE_DIR=%h/.hyadex
Environment=HYADEX_AGENT_CWD=%h
Environment=HYADEX_BACKEND=codex
# Set this on real deployments. Do not commit a real token.
# Environment=HYADEX_AGENT_TOKEN=replace-with-a-long-random-token
ExecStart=%h/.local/share/hyadex-server/current/.venv/bin/python %h/.local/share/hyadex-server/current/agent_server.py serve --bind 0.0.0.0 --port 7870
Restart=always
RestartSec=2
TimeoutStopSec=10s

[Install]
WantedBy=default.target
